DATABASE_URL="postgresql://github_radar:github_radar@127.0.0.1:55432/github_radar?schema=public"

# Conservative crawler defaults. CLI flags override these values.
CRAWL_DELAY_MS=1500
CRAWL_TIMEOUT_MS=20000
CRAWL_MAX_RETRIES=4
CRAWL_USER_AGENT="GitHubRadarIndexer/0.1 (contact: you@example.com)"

GITHUB_TOKEN=""
GITHUB_CONCURRENCY=3

# AI Product Selection Stage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Set to codex only for local authenticated CLI runs; production workers should use openai.
AI_PROVIDER=openai
AI_CODEX_MODEL=
AI_CONCURRENCY=2
AI_BATCH_SIZE=10
AI_README_MAX_CHARS=30000
